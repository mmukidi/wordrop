# Podfile for Wordrop iOS app
# Critical: Install npm dependencies BEFORE Xcode resolves SPM packages

platform :ios, '13.0'

# Get the root directory (parent of ios/App)
root_dir = File.dirname(File.dirname(File.dirname(__FILE__)))

# Install npm dependencies - this MUST run before package resolution
puts "🔧 Installing npm dependencies for Wordrop..."
install_cmd = "cd '#{root_dir}' && npm ci --legacy-peer-deps 2>&1"
result = system(install_cmd)

if !result
  puts "⚠️  npm ci failed, trying npm install..."
  install_cmd = "cd '#{root_dir}' && npm install --legacy-peer-deps 2>&1"
  system(install_cmd)
end

# Verify critical packages exist
critical_packages = [
  'node_modules/@capacitor/status-bar',
  'node_modules/@capacitor/local-notifications',
  'node_modules/@capacitor/share',
  'node_modules/@capacitor/haptics'
]

critical_packages.each do |pkg|
  pkg_path = File.join(root_dir, pkg)
  if !File.exist?(pkg_path)
    puts "❌ MISSING: #{pkg_path}"
  end
end

target 'App' do
  capacitor_pods
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
